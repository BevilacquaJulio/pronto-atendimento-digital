# =============================================================================
# PAD — variáveis do ambiente Docker (produção / Traefik)
# Copie para .env antes de executar os comandos do Compose.
# O arquivo .env contém segredos e nunca deve ser versionado.
# =============================================================================

# Público (Traefik) -----------------------------------------------------------
DOMAIN=pad.seudominio.com.br
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# MySQL compartilhado (nome do container na rede mysql_shared — nunca localhost)
MYSQL_HOST=mysql_shared
MYSQL_PORT=3306
MYSQL_DATABASE=pad
MYSQL_USER=pad
MYSQL_PASSWORD=
DATABASE_URL=

# Autenticação ----------------------------------------------------------------
# Use um valor aleatório e longo fora do ambiente local.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Sala de vídeo ---------------------------------------------------------------
# O TTL máximo aceito pela API é 900 segundos, conforme o case.
SALA_TOKEN_TTL_SEG=900
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# URL devolvida ao navegador. O NODE_IP é o endereço anunciado nos candidatos
# ICE e nunca deve ser o IP interno do container.
LIVEKIT_PUBLIC_URL=wss://livekit.pad.seudominio.com.br
LIVEKIT_NODE_IP=203.0.113.10
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# Backend ---------------------------------------------------------------------
API_PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://pad.seudominio.com.br
