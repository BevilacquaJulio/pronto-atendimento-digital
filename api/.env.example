# Copie para api/.env e ajuste. Este arquivo vai para o repositório; o .env não.
#
# A lista abaixo é a mesma que src/config/ambiente.ts valida no boot: se faltar
# alguma obrigatória, a API não sobe e diz exatamente qual.
# Em desenvolvimento local o MySQL costuma estar no host (porta publicada do
# mysql_shared). Dentro do Compose, o host é mysql_shared — ver .env da raiz.

# Obrigatórias ---------------------------------------------------------------
DATABASE_URL="mysql://pad:pad@localhost:3306/pad"
JWT_SECRET="troque-por-um-segredo-de-no-minimo-16-caracteres"

# Necessária apenas para executar `npm run db:seed` fora de produção.
# Deixe vazia no exemplo e defina uma senha local com pelo menos 12 caracteres.
SEED_DEMO_PASSWORD=""

# Opcionais (o valor abaixo é o padrão aplicado quando ausente) ---------------
JWT_EXPIRES_IN="1h"
SALA_TOKEN_TTL_SEG=900
LIVEKIT_URL="ws://localhost:7880"
# URL devolvida ao navegador. Quando ausente, usa LIVEKIT_URL.
LIVEKIT_PUBLIC_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecretdevsecretdevsecret32chr"
API_PORT=3000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development
